# Copy this file to .env and fill in your local paths.
# .env is gitignored — never commit it.

# CUDA installation directory (used to set XLA_FLAGS for TF XLA inference)
# Leave blank if not using TF XLA or if CUDA is on your system PATH already.
CUDA_DIR=C:/Program Files/NVIDIA GPU Computing Toolkit/CUDA/v11.8

# Stockfish binary
SF_LOC=C:/path/to/stockfish.exe

# Leela Chess Zero binary (only needed for lc0 review tools)
LC0_LOC=C:/path/to/lc0.exe

# Syzygy endgame tablebase directory (only needed if use_syzygy=true in config)
ENDGAME_LOC=C:/path/to/endgame_tables

# Base directory where selfplay run folders are stored
SP_DIR=C:/path/to/selfplay_runs/

# Base directory where model files are stored
MODEL_DIR=C:/path/to/models/

# Directory where bootstrap TFRecord shards are written / read
BOOTSTRAP_TFREC_DIR=C:/path/to/bootstrap_tfrecords

# Pre-opened position UCI path files (pkl)
PRE_OPENED_UCI_PATHS=C:/path/to/pre_opened_uci_paths_over2.pkl
PRE_OPENED_UCI_PATHS_MINI=C:/path/to/pre_opened_uci_paths_upto2.pkl

# UHO opening book PGN
UHO_PGN_PATH=C:/path/to/opening_books/UHO_XXL_2022_+100_+129.pgn
